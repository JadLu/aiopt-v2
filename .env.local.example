# kie.ai — get your key at https://kie.ai/api-key
KIE_AI_API_KEY=

# Cloudinary — signed uploads (see /api/upload-signature). No unsigned upload preset is used.
# Cloud name + API key/secret from Cloudinary dashboard → Settings → API Keys. Keep the secret server-side only.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Admin SDK — for server-side ID token verification and credit writes (API routes only).
# Download from Firebase Console → Project Settings → Service Accounts → Generate new private key
# Paste the entire JSON object as a single-line string
# (The client Firebase config is public and hardcoded in lib/firebase/config.ts.)
FIREBASE_SERVICE_ACCOUNT_JSON=
